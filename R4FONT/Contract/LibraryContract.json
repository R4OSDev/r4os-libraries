  "ownership_rules": [
    {
      "name": "Decoderhandle",
      "text": "Ein Decoderhandle gehoert dem Caller, wird mit decoder_destroy geschlossen und darf erst nach allen zugehoerigen Faces zerstoert werden."
    },
    {
      "name": "Facehandle",
      "text": "Ein Facehandle gehoert dem Caller und wird mit face_close geschlossen; es ist an Decoder und Providergeneration gebunden."
    },
    {
      "name": "Fontdaten",
      "text": "decoder_open_face kopiert Fontdaten nicht. Der Caller haelt sie bis face_close unveraendert und lesbar."
    },
    {
      "name": "Allocator",
      "text": "Die Library kopiert Callbackadressen und Userkontext. Sie bleiben bis decoder_destroy gueltig; Allokationen werden ueber denselben Allocator freigegeben."
    },
    {
      "name": "Namen",
      "text": "Familien- und Stilnamen bleiben provider-owned, nullterminiert und nur bis face_close gueltig."
    },
    {
      "name": "Providergeneration",
      "text": "API-Tabelle, Funktionspointer und alle Handles gelten nur fuer die geladene R4FONT-Providergeneration."
    }
  ]
