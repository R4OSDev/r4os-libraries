+  static void*
+  woff2_brotli_alloc( void*   opaque,
+                      size_t  size )
+  {
+    FT_Memory  memory  = (FT_Memory)opaque;
+    FT_Long    ft_size = (FT_Long)size;
+
+
+    if ( !memory || ft_size <= 0 || (size_t)ft_size != size )
+      return NULL;
+
+    return memory->alloc( memory, ft_size );
+  }
+
+
+  static void
+  woff2_brotli_free( void*  opaque,
+                     void*  block )
+  {
+    FT_Memory  memory = (FT_Memory)opaque;
+
+
+    if ( memory && block )
+      memory->free( memory, block );
+  }
+
+
   static FT_Error
   woff2_decompress( FT_Byte*        dst,
                     FT_ULong        dst_size,
                     const FT_Byte*  src,
-                    FT_ULong        src_size )
+                    FT_ULong        src_size,
+                    FT_Memory       memory )
   {
-    /* this cast is only of importance on 32bit systems; */
-    /* we don't validate it                              */
-    FT_Offset            uncompressed_size = (FT_Offset)dst_size;
-    BrotliDecoderResult  result;
-
+    BrotliDecoderState*  state;
+    BrotliDecoderResult  result = BROTLI_DECODER_RESULT_ERROR;
+    size_t               available_in  = (size_t)src_size;
+    size_t               available_out = (size_t)dst_size;
+    const uint8_t*       next_in        = src;
+    uint8_t*             next_out       = dst;
+    size_t               total_out      = 0;
+
+
+    state = BrotliDecoderCreateInstance( woff2_brotli_alloc,
+                                         woff2_brotli_free,
+                                         memory );
+    if ( !state )
+      return FT_THROW( Out_Of_Memory );
+
+    for (;;)
+    {
+      size_t          previous_in  = available_in;
+      size_t          previous_out = available_out;
+      const uint8_t*  previous_src = next_in;
