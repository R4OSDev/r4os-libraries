META=binding.c=Bindings/C/r4font.h
META=contract.api=Contract/LibraryContract.json
META=scope=userland-font-codec-runtime
META=feature=r4font.ttf
META=feature=r4font.otf-cff
META=feature=r4font.woff
META=feature=r4font.woff2
META=feature=r4font.ttc
