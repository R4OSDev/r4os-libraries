SOURCE=ThirdParty/r4font/freetype/src/cff/cff.c
SOURCE=ThirdParty/r4font/freetype/src/gzip/ftgzip.c
SOURCE=ThirdParty/r4font/freetype/src/psaux/psaux.c
SOURCE=ThirdParty/r4font/freetype/src/pshinter/pshinter.c
SOURCE=ThirdParty/r4font/freetype/src/psnames/psnames.c
SOURCE=ThirdParty/r4font/freetype/src/sfnt/sfnt.c
SOURCE=ThirdParty/r4font/freetype/src/smooth/smooth.c
SOURCE=ThirdParty/r4font/freetype/src/truetype/truetype.c
