C_DEFINE=FT2_BUILD_LIBRARY=1
C_DEFINE=FT_CONFIG_OPTIONS_H=<r4font_ftoption.h>
C_DEFINE=FT_CONFIG_MODULES_H=<r4font_ftmodule.h>
C_DEFINE=BROTLI_STATIC_INIT=NONE
C_FLAG=-fno-pic
C_FLAG=-mcmodel=large
TARGET=/R4OS/LIBS/R4FONT.R4L
IMAGE_SCOPE=slim
EXPORT=API_V1:r4font_api_v1:1
EXPORT=Query:r4font_query:1
CONTRACT=Contract/LibraryContract.json
CONTRACT_BASELINE=Contract/LibraryContract.baseline.json
IMPLEMENTATION_ZIG=Contract/Generated/implementation_abi.zig
BINDING_ZIG=Bindings/Zig/r4font_abi.zig
BINDING_C=Bindings/C/r4font.h
CONFORMANCE_ZIG=Tests/Generated/contract_conformance.zig
CONFORMANCE_C=Tests/Generated/contract_conformance.c
API_REFERENCE=Docs/API.md
META=module.name=R4FONT
META=preload=system
META=feature=runtime-r4l
META=source.owner=Code/System/Libraries/R4FONT
