{
  "schema": 1,
  "clang": "19.1.7",
  "mesa": "26.2.2",
  "origin": "R4GL freestanding C/C++ profile and shared runtime headers; GL/Nouveau selection removed. No native-link or device capability claim.",
  "cpp_flags": [
    "-I${zig}/lib/libcxx/include",
    "-I${include}",
    "-target",
    "x86_64-unknown-none-elf",
    "-O2",
    "-ffreestanding",
    "-fno-stack-protector",
    "-fno-asynchronous-unwind-tables",
    "-fno-unwind-tables",
    "-fno-pic",
    "-mcmodel=large",
    "-mno-red-zone",
    "-ffunction-sections",
    "-fdata-sections",
    "-fvisibility=hidden",
    "-nostdinc",
    "-fno-math-errno",
    "-fno-trapping-math",
    "-fno-builtin",
    "-ferror-limit=5",
    "-isystem",
    "${clang_resource}/include",
    "-I${libraries}/R4NAK/Port/Include",
    "-I${generated}",
    "-I${generated}/include",
    "-I${source}/include",
    "-I${generated}/src",
    "-I${source}/src",
    "-I${generated}/src/compiler",
    "-I${source}/src/compiler",
    "-I${generated}/src/compiler/nir",
    "-I${source}/src/compiler/nir",
    "-I${generated}/src/compiler/rust",
    "-I${source}/src/compiler/rust",
    "-I${generated}/src/compiler/spirv",
    "-I${source}/src/compiler/spirv",
    "-I${generated}/src/util",
    "-I${source}/src/util",
    "-I${generated}/src/util/format",
    "-I${source}/src/util/format",
    "-DHAVE_GFX_COMPUTE",
    "-DMESA_DEBUG=0",
    "-DUSE_GCC_ATOMIC_BUILTINS",
    "-DHAVE_UINT128",
    "-DHAVE_STRUCT_TIMESPEC",
    "-DHAVE_POSIX_MEMALIGN",
    "-DUTIL_ARCH_LITTLE_ENDIAN=1",
    "-DUTIL_ARCH_BIG_ENDIAN=0",
    "-DXXH_FORCE_ALIGN_CHECK=0",
    "-DXXH_FORCE_MEMORY_ACCESS=0",
    "-DHAVE_FMEMOPEN",
    "-DHAVE_REALLOCARRAY",
    "-DPACKAGE_VERSION=\"26.2.2\"",
    "-DBLAKE3_NO_SSE2",
    "-DBLAKE3_NO_SSE41",
    "-DBLAKE3_NO_AVX2",
    "-DBLAKE3_NO_AVX512",
    "-DHAVE___BUILTIN_BSWAP32",
    "-DHAVE___BUILTIN_BSWAP64",
    "-DHAVE___BUILTIN_CLZ",
    "-DHAVE___BUILTIN_CLZLL",
    "-DHAVE___BUILTIN_CTZ",
    "-DHAVE___BUILTIN_EXPECT",
    "-DHAVE___BUILTIN_FFS",
    "-DHAVE___BUILTIN_FFSLL",
    "-DHAVE___BUILTIN_POPCOUNT",
    "-DHAVE___BUILTIN_POPCOUNTLL",
    "-DHAVE___BUILTIN_UNREACHABLE",
    "-DHAVE___BUILTIN_TYPES_COMPATIBLE_P",
    "-DHAVE___BUILTIN_ADD_OVERFLOW",
    "-DHAVE_FUNC_ATTRIBUTE_CONST",
    "-DHAVE_FUNC_ATTRIBUTE_FLATTEN",
    "-DHAVE_FUNC_ATTRIBUTE_MALLOC",
    "-DHAVE_FUNC_ATTRIBUTE_PURE",
    "-DHAVE_FUNC_ATTRIBUTE_UNUSED",
    "-DHAVE_FUNC_ATTRIBUTE_WARN_UNUSED_RESULT",
    "-DHAVE_FUNC_ATTRIBUTE_WEAK",
    "-DHAVE_FUNC_ATTRIBUTE_FORMAT",
    "-DHAVE_FUNC_ATTRIBUTE_PACKED",
    "-DHAVE_FUNC_ATTRIBUTE_RETURNS_NONNULL",
    "-DHAVE_FUNC_ATTRIBUTE_ALIAS",
    "-DHAVE_FUNC_ATTRIBUTE_NORETURN",
    "-DHAVE_FUNC_ATTRIBUTE_COLD",
    "-DHAVE_FUNC_ATTRIBUTE_VISIBILITY",
    "-femulated-tls",
    "-DPACKAGE_BUGREPORT=\"https://github.com/R4OSDev\"",
    "-DAMD_LLVM_AVAILABLE=0",
    "-DHAVE_STRTOF",
    "-DHAVE_STRTOK_R",
    "-DTHREAD_SANITIZER=0",
    "-I${generated}/src/util/libmesa_util.a.p",
    "-std=c++17",
    "-fno-exceptions",
    "-fno-rtti",
    "-nostdinc++",
    "-D_LIBCPP_ABI_VERSION=1",
    "-D_LIBCPP_ABI_NAMESPACE=__1",
    "-D_LIBCPP_HARDENING_MODE_DEFAULT=2",
    "-D_LIBCPP_HAS_THREADS=1",
    "-D_LIBCPP_HAS_THREAD_API_EXTERNAL=1",
    "-D_LIBCPP_HAS_MONOTONIC_CLOCK=1",
    "-D_LIBCPP_HAS_EXCEPTIONS=0",
    "-D_LIBCPP_HAS_LOCALIZATION=0",
    "-D_LIBCPP_HAS_FILESYSTEM=0",
    "-D_LIBCPP_HAS_WIDE_CHARACTERS=0",
    "-I${libraries}/Shared/Native",
    "-I${libraries}/R4VK/Bindings/C",
    "-I${sdk}/Shared/C/include",
    "-I${contract}/Generated/SDK/C/include"
  ]
}
