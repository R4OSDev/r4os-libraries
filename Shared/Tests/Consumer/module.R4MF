R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=LIBHPROBE
VERSION=0.1.0
LANGUAGE=Rust
SOURCE=src/main.rs
SOURCE=src/consumer.c
C_INCLUDE=../../C/include
C_INCLUDE=../../../R4STD/Bindings/C
C_INCLUDE=../../../R4IMG/Bindings/C
C_INCLUDE=../../../R4FONT/Bindings/C
ENTRY_MODE=app
APP_CLASS=console
TARGET=/SOFTWARE/LIBHPROBE.R4X
IMAGE_SCOPE=none
IMPORT=R4SYS:Query:1
IMPORT=R4STD:TEXT_V1:1
IMPORT=R4STD:SETTINGS_V1:1
IMPORT=R4STD:DATE_V1:1
IMPORT=R4STD:TIME_V1:1
IMPORT=R4STD:CONFIG_V1:1
IMPORT=R4STD:CODEC_V1:1
IMPORT=R4IMG:API_V1:1
IMPORT=R4IMG:PNG_V1:1
IMPORT=R4IMG:RASTER_V1:1
IMPORT=R4FONT:API_V1:1
META=memory.profile=normal
