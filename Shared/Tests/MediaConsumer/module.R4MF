R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=MEDHPROBE
VERSION=0.1.0
LANGUAGE=Rust
SOURCE=src/main.rs
SOURCE=src/consumer.c
C_INCLUDE=../../C/include
C_INCLUDE=../../../R4GFX/Bindings/C
C_INCLUDE=../../../R4ENC/Bindings/C
C_INCLUDE=../../../R4VIDEO/Bindings/C
C_INCLUDE=../../../R4ACO/Bindings/C
C_INCLUDE=../../../R4NAK/Bindings/C
ENTRY_MODE=app
APP_CLASS=console
TARGET=/SOFTWARE/MEDHPROBE.R4X
IMAGE_SCOPE=none
IMPORT=R4SYS:Query:1
IMPORT=R4GFX:COLOR_V1:4
IMPORT=R4ACO:COMPILER_V1:1:1
IMPORT=R4NAK:COMPILER_V1:1:1
META=memory.profile=normal
