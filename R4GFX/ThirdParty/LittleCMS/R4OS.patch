 // Internal, get associated pointer, with guessing. Never returns NULL.
 struct _cmsContext_struct* _cmsGetContext(cmsContext ContextID)
 {
+#ifdef CMS_R4OS
+    // R4GFX never exports a cmsContext. Its caller-owned context is retained
+    // through all calls, including allocator bootstrap using fakeContext.
+    return ContextID ? (struct _cmsContext_struct*) ContextID : &globalContext;
+#else
     struct _cmsContext_struct* id = (struct _cmsContext_struct*) ContextID;
     struct _cmsContext_struct* ctx;
 
@@ -739,6 +744,7 @@ struct _cmsContext_struct* _cmsGetContext(cmsContext ContextID)
 
     _cmsLeaveCriticalSectionPrimitive(&_cmsContextPoolHeadMutex);
     return &globalContext;
+#endif
 }
 
 
@@ -1027,6 +1033,15 @@ void* CMSEXPORT cmsGetContextUserData(cmsContext ContextID)
 // Use context mutex to provide thread-safe time
 cmsBool _cmsGetTime(struct tm* ptr_time)
 {
+#ifdef CMS_R4OS
+    // Virtual working profiles are deterministic and never claim a measured
+    // creation timestamp. Imported profile timestamps remain unchanged.
+    memset(ptr_time, 0, sizeof(*ptr_time));
+    ptr_time->tm_year = 100;
+    ptr_time->tm_mday = 1;
+    ptr_time->tm_wday = 6;
+    return TRUE;
+#else
     struct tm* t;
 #if defined(HAVE_GMTIME_R) || defined(HAVE_GMTIME_S)
     struct tm tm;
@@ -1052,4 +1067,5 @@ cmsBool _cmsGetTime(struct tm* ptr_time)
         *ptr_time = *t;
         return TRUE;
     }
+#endif
 }
