diff --git a/src/lcms2_internal.h b/src/lcms2_internal.h
index 26e4e86..c48814f 100644
--- a/src/lcms2_internal.h
+++ b/src/lcms2_internal.h
@@ -198,7 +198,25 @@ cmsINLINE cmsUInt16Number _cmsQuickSaturateWord(cmsFloat64Number d)
 #define CMSCHECKPOINT CMSAPI
 
 // Pthread support --------------------------------------------------------------------
-#ifndef CMS_NO_PTHREADS
+#if defined(CMS_R4OS)
+// R4OS port: no host threading dependency. The registry lock protects only
+// bounded pointer-list mutation; caller-owned transforms serialize their own
+// context. Frame conversion uses the direct owned-context path below.
+typedef unsigned int _cmsMutex;
+#define CMS_MUTEX_INITIALIZER 0
+cmsINLINE int _cmsLockPrimitive(_cmsMutex *m)
+{
+    while (__atomic_exchange_n(m, 1, __ATOMIC_ACQUIRE)) {
+        while (__atomic_load_n(m, __ATOMIC_RELAXED)) __asm__ volatile("pause");
+    }
+    return 0;
+}
+cmsINLINE int _cmsUnlockPrimitive(_cmsMutex *m) { __atomic_store_n(m, 0, __ATOMIC_RELEASE); return 0; }
+cmsINLINE int _cmsInitMutexPrimitive(_cmsMutex *m) { *m = 0; return 0; }
+cmsINLINE int _cmsDestroyMutexPrimitive(_cmsMutex *m) { (void)m; return 0; }
+cmsINLINE int _cmsEnterCriticalSectionPrimitive(_cmsMutex *m) { return _cmsLockPrimitive(m); }
+cmsINLINE int _cmsLeaveCriticalSectionPrimitive(_cmsMutex *m) { return _cmsUnlockPrimitive(m); }
+#elif !defined(CMS_NO_PTHREADS)
 
 // This is the threading support. Unfortunately, it has to be platform-dependent because 
 // windows does not support pthreads. 
