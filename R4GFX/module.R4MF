R4OS_MODULE_MANIFEST=2
KIND=R4L
NAME=R4GFX
VERSION=0.1.26
LANGUAGE=Zig
SOURCE=Source/main.zig
SOURCE=Source/color_icc.c
SOURCE=ThirdParty/LittleCMS/src/cmsalpha.c
SOURCE=ThirdParty/LittleCMS/src/cmscam02.c
SOURCE=ThirdParty/LittleCMS/src/cmscnvrt.c
SOURCE=ThirdParty/LittleCMS/src/cmserr.c
SOURCE=ThirdParty/LittleCMS/src/cmsgamma.c
SOURCE=ThirdParty/LittleCMS/src/cmsgmt.c
SOURCE=ThirdParty/LittleCMS/src/cmshalf.c
SOURCE=ThirdParty/LittleCMS/src/cmsintrp.c
SOURCE=ThirdParty/LittleCMS/src/cmsio0.c
SOURCE=ThirdParty/LittleCMS/src/cmsio1.c
SOURCE=ThirdParty/LittleCMS/src/cmslut.c
SOURCE=ThirdParty/LittleCMS/src/cmsmd5.c
SOURCE=ThirdParty/LittleCMS/src/cmsmtrx.c
SOURCE=ThirdParty/LittleCMS/src/cmsnamed.c
SOURCE=ThirdParty/LittleCMS/src/cmsopt.c
SOURCE=ThirdParty/LittleCMS/src/cmspack.c
SOURCE=ThirdParty/LittleCMS/src/cmspcs.c
SOURCE=ThirdParty/LittleCMS/src/cmsplugin.c
SOURCE=ThirdParty/LittleCMS/src/cmssamp.c
SOURCE=ThirdParty/LittleCMS/src/cmssm.c
SOURCE=ThirdParty/LittleCMS/src/cmstypes.c
SOURCE=ThirdParty/LittleCMS/src/cmsvirt.c
SOURCE=ThirdParty/LittleCMS/src/cmswtpnt.c
SOURCE=ThirdParty/LittleCMS/src/cmsxform.c
C_INCLUDE=Source/ColorPort
C_INCLUDE=ThirdParty/LittleCMS/include
C_DEFINE=CMS_R4OS=1
C_DEFINE=CMS_NO_PTHREADS=1
C_DEFINE=CMS_NO_REGISTER_KEYWORD=1
C_FLAG=-std=c11
C_FLAG=-fno-builtin
C_FLAG=-fno-pic
C_FLAG=-mcmodel=large
TARGET=/R4OS/LIBS/R4GFX.R4L
IMAGE_SCOPE=slim
OPTIMIZE=speed
EXPORT=API_V1:r4gfx_api_v1:1
EXPORT=RENDER_V1:r4gfx_render_v1:1
EXPORT=DEVICE_V1:r4gfx_device_v1:10
EXPORT=COLOR_V1:r4gfx_color_v1:4
EXPORT=Query:r4gfx_query:1
ZIG_MODULE=r4nv_binding:../R4NV/Bindings/Zig/r4nv.zig
ZIG_MODULE=r4amd_binding:../R4AMD/Bindings/Zig/r4amd.zig
CONTRACT=Contract/LibraryContract.json
CONTRACT_BASELINE=Contract/LibraryContract.baseline.json
IMPLEMENTATION_ZIG=Contract/Generated/implementation_abi.zig
BINDING_ZIG=Bindings/Zig/r4gfx_abi.zig
BINDING_C=Bindings/C/r4gfx.h
CONFORMANCE_ZIG=Tests/Generated/contract_conformance.zig
CONFORMANCE_C=Tests/Generated/contract_conformance.c
API_REFERENCE=Docs/API.md
META=module.name=R4GFX
META=preload=system
META=feature=runtime-r4l
META=source.owner=Repositories/Libraries/R4GFX
META=binding.zig=Bindings/Zig/r4gfx_abi.zig
META=binding.c=Bindings/C/r4gfx.h
META=contract.api=Contract/LibraryContract.json
META=scope=userland-graphics-buffer-software
