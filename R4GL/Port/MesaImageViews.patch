 struct pipe_resource;
+
+#if defined(R4OS_OPENGL)
+/* EGLImage imports expose one physical image as logical 2D level zero.
+ * Use the same address for transfers, copies and clears as sampler/FBO views.
+ * Ordinary immutable texture views retain their MinLevel/MinLayer offsets. */
+static inline unsigned
+st_r4os_image_level(const struct gl_texture_image *image)
+{
+   const struct gl_texture_object *obj = image->TexObject;
+   if (obj->surface_based && obj->level_override >= 0)
+      return obj->level_override;
+   /* A loose single-level resource stores its GL image at physical level 0;
+    * a retained mip tree keeps its levels even if obj->pt has been replaced. */
+   return (image->pt && image->pt->last_level ? image->Level : 0) + obj->Attrib.MinLevel;
+}
+
+static inline unsigned
+st_r4os_image_layer(const struct gl_texture_image *image, unsigned slice)
+{
+   const struct gl_texture_object *obj = image->TexObject;
+   if (obj->surface_based && obj->layer_override >= 0)
+      return obj->layer_override + slice;
+   return image->Face + obj->Attrib.MinLayer + slice;
+}
+#endif
 
 
