 {
+#if defined(R4OS_OPENGL)
+   struct r4gl_process_name_state *state = r4gl_process_name_state();
+   char *name = p_atomic_read(&state->name);
+   if (name)
+      return name;
+   simple_mtx_lock(&state->mutex);
+   name = state->name;
+   if (!name) {
+      const char *override_name = os_get_option("MESA_PROCESS_NAME");
+      name = override_name ? strdup(override_name) : __getProgramName();
+      if (name && atexit(free_program_name) != 0) {
+         free(name);
+         name = NULL;
+      }
+      if (name)
+         p_atomic_set(&state->name, name);
+   }
+   simple_mtx_unlock(&state->mutex);
+   return name;
+#else
    static util_once_flag once_state = UTIL_ONCE_FLAG_INIT;
    util_call_once(&once_state, util_get_process_name_callback);
    return program_name;
+#endif
 }
 
