// libc++'s external platform boundary uses the native Mesa C11 transport.
#ifndef R4GL_EXTERNAL_THREADING
#define R4GL_EXTERNAL_THREADING
#include <__config>
#include <__chrono/duration.h>
#include <c11/threads.h>
#include <errno.h>
_LIBCPP_BEGIN_NAMESPACE_STD
using __libcpp_timespec_t = ::timespec;
using __libcpp_mutex_t = ::mtx_t;
using __libcpp_recursive_mutex_t = ::mtx_t;
#define _LIBCPP_MUTEX_INITIALIZER {}
inline int __libcpp_mutex_lock(mtx_t *m) { return mtx_lock(m) == thrd_success ? 0 : EINVAL; }
inline bool __libcpp_mutex_trylock(mtx_t *m) { return mtx_trylock(m) == thrd_success; }
inline int __libcpp_mutex_unlock(mtx_t *m) { return mtx_unlock(m) == thrd_success ? 0 : EINVAL; }
inline int __libcpp_mutex_destroy(mtx_t *m) { mtx_destroy(m); return 0; }
inline int __libcpp_recursive_mutex_init(mtx_t *m) { return mtx_init(m, mtx_plain | mtx_recursive) == thrd_success ? 0 : EINVAL; }
inline int __libcpp_recursive_mutex_lock(mtx_t *m) { return __libcpp_mutex_lock(m); }
inline bool __libcpp_recursive_mutex_trylock(mtx_t *m) { return __libcpp_mutex_trylock(m); }
inline int __libcpp_recursive_mutex_unlock(mtx_t *m) { return __libcpp_mutex_unlock(m); }
inline int __libcpp_recursive_mutex_destroy(mtx_t *m) { return __libcpp_mutex_destroy(m); }
using __libcpp_condvar_t = ::cnd_t;
#define _LIBCPP_CONDVAR_INITIALIZER {}
inline int __libcpp_condvar_signal(cnd_t *c) { return cnd_signal(c) == thrd_success ? 0 : EINVAL; }
inline int __libcpp_condvar_broadcast(cnd_t *c) { return cnd_broadcast(c) == thrd_success ? 0 : EINVAL; }
inline int __libcpp_condvar_wait(cnd_t *c, mtx_t *m) { return cnd_wait(c, m) == thrd_success ? 0 : EINVAL; }
int __libcpp_condvar_timedwait(cnd_t *, mtx_t *, timespec *);
inline int __libcpp_condvar_destroy(cnd_t *c) { cnd_destroy(c); return 0; }
using __libcpp_exec_once_flag = ::once_flag;
#define _LIBCPP_EXEC_ONCE_INITIALIZER ONCE_FLAG_INIT
inline int __libcpp_execute_once(::once_flag *f, void (*routine)()) { ::call_once(f, routine); return 0; }
using __libcpp_thread_t = ::thrd_t;
using __libcpp_thread_id = uint64_t;
#define _LIBCPP_NULL_THREAD (::thrd_t{})
// Kernel thread generations are nonzero, monotonic and never wrap.
inline bool __libcpp_thread_id_equal(uint64_t a, uint64_t b) { return a == b; }
inline bool __libcpp_thread_id_less(uint64_t a, uint64_t b) { return a < b; }
inline uint64_t __libcpp_thread_get_id(const thrd_t *t) { return t->thread_generation; }
inline bool __libcpp_thread_isnull(const thrd_t *t) { return t->thread_id == 0; }
inline uint64_t __libcpp_thread_get_current_id() { return thrd_current().thread_generation; }
int __libcpp_thread_create(thrd_t *, void *(*)(void *), void *);
int __libcpp_thread_join(thrd_t *);
int __libcpp_thread_detach(thrd_t *);
inline void __libcpp_thread_yield() { thrd_yield(); }
void __libcpp_thread_sleep_for(const chrono::nanoseconds &);
#define _LIBCPP_TLS_DESTRUCTOR_CC
using __libcpp_tls_key = uintptr_t;
int __libcpp_tls_create(__libcpp_tls_key *, void (*)(void *));
void *__libcpp_tls_get(__libcpp_tls_key);
int __libcpp_tls_set(__libcpp_tls_key, void *);
_LIBCPP_END_NAMESPACE_STD
#endif
