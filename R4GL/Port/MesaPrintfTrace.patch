+static bool
+printf_try_add_locked(const u_printf_info *info)
+{
+   assert_singleton_exists_and_is_locked();
+   uint32_t hash;
+   if (!printf_try_hash(info, &hash))
+      return false;
+   const u_printf_info *cached = u_printf_singleton_search_locked(hash);
+   if (cached) {
+      assert(!strcmp(cached->strings, info->strings) && "assume no collisions");
+      return true;
+   }
+
+   /* Keep the unpublished clone's children together so every allocation or
+    * insertion failure can discard it without exposing partial metadata. */
+   u_printf_info *clone = rzalloc(u_printf_cache.ht, u_printf_info);
+   if (!clone)
+      return false;
+   clone->num_args = info->num_args;
+   clone->string_size = info->string_size;
+   if (info->num_args) {
+      clone->arg_sizes = ralloc_memdup(clone, info->arg_sizes,
+         sizeof(info->arg_sizes[0]) * info->num_args);
+      if (!clone->arg_sizes)
+         goto fail;
+   }
+   clone->strings = ralloc_memdup(clone, info->strings, info->string_size);
+   if (info->string_size && !clone->strings)
+      goto fail;
+
+   /* The native target is x86_64, where Mesa's u64 table uses pointer keys.
+    * Its void wrapper discards insertion failure; inspect the real result. */
+   STATIC_ASSERT(sizeof(void *) == 8);
+   if (!_mesa_hash_table_insert(&u_printf_cache.ht->table,
+                               (void *)(uintptr_t)hash, clone))
+      goto fail;
+   return true;
+fail:
+   ralloc_free(clone);
+   return false;
