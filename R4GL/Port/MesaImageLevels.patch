+#if defined(R4OS_OPENGL)
+/* Exported images need stable storage through BaseLevel/MaxLevel changes.
+ * Reserve the complete compatible mip tree before publishing the first
+ * external reference, including matching images outside the active range. */
+GLboolean
+st_r4os_prepare_egl_image(struct gl_context *ctx, struct gl_texture_object *obj,
+                           GLuint face, GLuint level)
+{
+   if (obj->Immutable || obj->surface_based)
+      return GL_TRUE;
+   struct st_context *st = st_context(ctx);
+   struct gl_texture_image *selected = obj->Image[face][level];
+   struct gl_texture_image *root = selected;
+   const unsigned faces = _mesa_num_tex_faces(obj->Target);
+
+   /* Prefer the lowest defined compatible image. Extrapolating 2x2 at level
+    * one as a 4x4 root would lose a known non-power-of-two 5x5 level zero. */
+   for (unsigned l = 0; l < level; l++) {
+      struct gl_texture_image *img = obj->Image[face][l];
+      if (img && img->Width && !img->Border &&
+          img->TexFormat == selected->TexFormat &&
+          u_minify(img->Width, level - l) == selected->Width &&
+          u_minify(img->Height, level - l) == selected->Height &&
+          u_minify(img->Depth, level - l) == selected->Depth) {
+         root = img;
+         break;
+      }
+   }
+
+   unsigned width, height;
+   uint16_t depth, layers;
+   st_gl_texture_dims_to_pipe_dims(obj->Target, root->Width, root->Height,
+                                   root->Depth, &width, &height, &depth, &layers);
+   if (root->pt && st_texture_match_image(st, root->pt, root)) {
+      width = root->pt->width0;
+      height = root->pt->height0;
+      depth = root->pt->depth0;
+   } else {
+      width = width > 1 ? width << root->Level : 1;
+      height = height > 1 ? height << root->Level : 1;
+      depth = depth > 1 ? depth << root->Level : 1;
+      if (width == 1 && height == 1 && depth == 1) {
+         width <<= root->Level;
+         if (obj->Target == GL_TEXTURE_CUBE_MAP)
+            height = width;
+      }
+   }
+   unsigned last = _mesa_get_tex_max_num_levels(obj->Target, width, height, depth) - 1;
+   struct pipe_resource shape = {
+      .target = gl_target_to_pipe(obj->Target),
+      .format = st_mesa_format_to_pipe_format(st, selected->TexFormat),
+      .width0 = width, .height0 = height, .depth0 = depth,
+      .array_size = layers, .last_level = last,
+      .nr_samples = selected->NumSamples,
+   };
+   if (!st_texture_match_image(st, &shape, selected))
+      return GL_FALSE;
+
+   struct pipe_resource *storage = NULL;
+   /* Previously exported compatible images must agree on one allocation.
+    * A failed preparation never silently moves an existing external alias. */
+   for (unsigned f = 0; f < faces; f++)
+      for (unsigned l = 0; l < MAX_TEXTURE_LEVELS; l++) {
+         struct gl_texture_image *img = obj->Image[f][l];
+         if (!img || !img->R4OSImageSibling ||
+             !st_texture_match_image(st, &shape, img))
+            continue;
+         struct pipe_resource *pt = img->pt;
+         if (!pt || pt->target != shape.target || pt->width0 != width ||
+             pt->height0 != height || pt->depth0 != depth ||
+             pt->array_size != layers || pt->last_level < last ||
+             (storage && storage != pt))
+            return GL_FALSE;
+         storage = pt;
+      }
+   if (!storage && root->pt) {
+      struct pipe_resource *pt = root->pt;
+      if (pt->target == shape.target && pt->format == shape.format &&
+          pt->width0 == width && pt->height0 == height && pt->depth0 == depth &&
+          pt->array_size == layers && pt->last_level >= last &&
+          pt->nr_samples == selected->NumSamples)
+         storage = pt;
+   }
+   if (storage) {
+      struct pipe_resource *owned = NULL;
+      pipe_resource_reference(&owned, storage);
+      storage = owned;
+   } else {
+      /* Allocation precedes all object/image mutation. */
+      GLuint bindings = default_bindings(st, shape.format);
+      if (obj->IsProtected)
+         bindings |= PIPE_BIND_PROTECTED;
+      storage = st_texture_create(st, shape.target, shape.format, last,
+                                   width, height, depth, layers,
+                                   selected->NumSamples, 0, bindings, false,
+                                   PIPE_COMPRESSION_FIXED_RATE_NONE);
+      if (!storage)
+         return GL_FALSE;
+   }
+   pipe_resource_reference(&obj->pt, storage);
+   st_texture_release_all_sampler_views(st, obj);
+   for (unsigned f = 0; f < faces; f++)
+      for (unsigned l = 0; l < MAX_TEXTURE_LEVELS; l++) {
+         struct gl_texture_image *img = obj->Image[f][l];
+         if (img && img->Width && img->pt != storage &&
+             st_texture_match_image(st, storage, img)) {
+            copy_image_data_to_texture(st, obj, l, img);
+            _mesa_update_fbo_texture(ctx, obj, f, l);
+         }
+      }
+   pipe_resource_reference(&storage, NULL);
+   _mesa_dirty_texobj(ctx, obj);
+   obj->needs_validation = true;
+   ST_SET_FRAMEBUFFER_STATES(ctx->NewDriverState);
+   return GL_TRUE;
+}
+#endif
