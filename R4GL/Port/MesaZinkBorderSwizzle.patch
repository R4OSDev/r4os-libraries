+#ifdef R4OS_OPENGL
+/* GFX9's Vulkan border-color contract only defines identity view mappings.
+ * Keep that view identity and apply the GL mapping to sampled values in NIR.
+ * Keys remain per-stage/per-binding, including sampler arrays and gathers. */
+static nir_def *
+r4gl_swizzle_constant(nir_builder *b, nir_tex_instr *tex, unsigned components, bool one)
+{
+   nir_def *scalar = nir_alu_type_get_base_type(tex->dest_type) == nir_type_float ?
+      nir_imm_floatN_t(b, one ? 1.0 : 0.0, tex->def.bit_size) :
+      nir_imm_intN_t(b, one ? 1 : 0, tex->def.bit_size);
+   return nir_replicate(b, scalar, components);
+}
+static bool
+r4gl_lower_identity_swizzle(nir_builder *b, nir_tex_instr *tex,
+                            const struct lower_zs_swizzle_state *state)
+{
+   const struct zink_zs_swizzle_key *key = state->swizzle;
+   if (!key || !key->r4gl_identity_mask || tex->is_shadow ||
+       nir_tex_instr_is_query(tex) || tex->sampler_dim == GLSL_SAMPLER_DIM_BUF)
+      return false;
+   const int source = nir_tex_instr_src_index(tex, nir_tex_src_texture_deref);
+   if (source < 0) return false; /* Bindless is not advertised for this path. */
+   nir_deref_instr *deref = nir_def_as_deref(tex->src[source].src.ssa);
+   nir_variable *var = nir_deref_instr_get_variable(deref);
+   if (!var || var->data.binding < state->base_sampler_id) return false;
+   const unsigned first = var->data.binding - state->base_sampler_id;
+   const unsigned count = glsl_type_is_array(var->type) ? glsl_get_aoa_size(var->type) : 1;
+   if (first >= 32 || !count || count > 32 - first) return false;
+   const uint32_t candidates = key->r4gl_identity_mask & (BITFIELD_MASK(count) << first);
+   if (!candidates) return false;
+   b->cursor = nir_after_instr(&tex->instr);
+   nir_def *index = nir_imm_int(b, first);
+   for (nir_deref_instr *at = deref; at->deref_type != nir_deref_type_var;
+        at = nir_deref_instr_parent(at)) {
+      assert(at->deref_type == nir_deref_type_array);
+      const unsigned stride = glsl_type_is_array(at->type) ? glsl_get_aoa_size(at->type) : 1;
+      index = nir_iadd(b, index, nir_imul_imm(b, at->arr.index.ssa, stride));
+   }
+   nir_def *gathers[4] = {0};
+   if (tex->op == nir_texop_tg4) {
+      const unsigned original = tex->component;
+      gathers[original] = &tex->def;
+      for (unsigned slot = first; slot < first + count; slot++) {
+         if (!(candidates & BITFIELD_BIT(slot))) continue;
+         const unsigned component = key->swizzle[slot].s[original];
+         if (component >= 4 || gathers[component]) continue;
+         nir_tex_instr *copy = nir_instr_as_tex(nir_instr_clone(b->shader, &tex->instr));
+         copy->component = component;
+         nir_builder_instr_insert(b, &copy->instr);
+         gathers[component] = &copy->def;
+      }
+   }
+   nir_def *result = &tex->def;
+   for (unsigned slot = first; slot < first + count; slot++) {
+      if (!(candidates & BITFIELD_BIT(slot))) continue;
+      const uint8_t *s = key->swizzle[slot].s;
+      nir_def *mapped;
+      if (tex->op == nir_texop_tg4) {
+         const unsigned component = s[tex->component];
+         if (component < 4) mapped = gathers[component];
+         else mapped = r4gl_swizzle_constant(b, tex, 4, component == PIPE_SWIZZLE_1);
+      } else {
+         nir_def *values[5];
+         assert(tex->def.num_components >= 4 && tex->def.num_components <= 5);
+         for (unsigned channel = 0; channel < 4; channel++) {
+            if (s[channel] < 4) values[channel] = nir_channel(b, &tex->def, s[channel]);
+            else values[channel] = r4gl_swizzle_constant(b, tex, 1, s[channel] == PIPE_SWIZZLE_1);
+         }
+         if (tex->def.num_components == 5) values[4] = nir_channel(b, &tex->def, 4);
+         mapped = nir_vec(b, values, tex->def.num_components);
+      }
+      result = nir_bcsel(b, nir_ieq_imm(b, index, slot), mapped, result);
+   }
+   nir_def_rewrite_uses_after(&tex->def, result);
+   return true;
+}
