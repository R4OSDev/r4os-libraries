+#if defined(R4OS_OPENGL)
+/* A structural change orphans the whole texture (KHR_gl_image issues 2/4,
+ * OES_EGL_image). Clone each distinct allocation once before publishing any
+ * new pointers. On allocation failure every sibling retains its old storage.
+ * Caller holds the shared texture mutex; deletion never takes this path. */
+GLboolean
+st_r4os_orphan_egl_images(struct gl_context *ctx, struct gl_texture_object *obj)
+{
+   struct st_context *st = st_context(ctx);
+   const unsigned faces = _mesa_num_tex_faces(obj->Target);
+   struct pipe_resource *old[6 * MAX_TEXTURE_LEVELS] = {0};
+   struct pipe_resource *fresh[6 * MAX_TEXTURE_LEVELS] = {0};
+   unsigned count = 0;
+   bool shared = false;
+
+   for (unsigned f = 0; f < faces; f++)
+      for (unsigned l = 0; l < MAX_TEXTURE_LEVELS; l++) {
+         struct gl_texture_image *img = obj->Image[f][l];
+         shared |= img && img->R4OSImageSibling;
+      }
+   if (!shared)
+      return GL_TRUE;
+
+   /* Imported 2D views may address one cube face, 3D slice or mip level.
+    * Materialize just that logical image before clearing its overrides. */
+   const bool view = obj->surface_based;
+   for (unsigned f = 0; f < faces; f++) {
+      for (unsigned l = 0; l < MAX_TEXTURE_LEVELS; l++) {
+         struct gl_texture_image *img = obj->Image[f][l];
+         if (!img || !img->pt)
+            continue;
+         unsigned i;
+         for (i = 0; i < count && old[i] != img->pt; i++) {}
+         if (i < count)
+            continue;
+         struct pipe_resource templ = *img->pt;
+         templ.bind = default_bindings(st, templ.format);
+         templ.flags = 0;
+         templ.usage = PIPE_USAGE_DEFAULT;
+         if (view) {
+            templ.target = PIPE_TEXTURE_2D;
+            templ.width0 = img->Width;
+            templ.height0 = img->Height;
+            templ.depth0 = templ.array_size = 1;
+            templ.last_level = 0;
+         }
+         fresh[count] = st->screen->resource_create(st->screen, &templ);
+         if (!fresh[count]) {
+            for (i = 0; i < count; i++)
+               pipe_resource_reference(&fresh[i], NULL);
+            _mesa_error(ctx, GL_OUT_OF_MEMORY, "EGLImage texture orphan");
+            return GL_FALSE;
+         }
+         old[count++] = img->pt;
+      }
+   }
+
+   for (unsigned i = 0; i < count; i++) {
+      for (unsigned l = 0; l <= fresh[i]->last_level; l++) {
+         struct pipe_box box = {
+            .width = u_minify(fresh[i]->width0, l),
+            .height = u_minify(fresh[i]->height0, l),
+            .depth = util_max_layer(fresh[i], l) + 1,
+         };
+         unsigned src_level = l;
+         if (view) {
+            src_level = MAX2(obj->level_override, 0);
+            box.z = MAX2(obj->layer_override, 0);
+         }
+         st->pipe->resource_copy_region(st->pipe, fresh[i], l, 0, 0, 0,
+                                        old[i], src_level, &box);
+      }
+   }
+
+   /* Do not let later mipmap consolidation choose an old shared allocation. */
+   struct pipe_resource *canonical = NULL;
+   for (unsigned i = 0; i < count; i++)
+      if (obj->pt == old[i])
+         canonical = fresh[i];
+   pipe_resource_reference(&obj->pt, canonical);
+   obj->surface_based = GL_FALSE;
+   obj->level_override = obj->layer_override = -1;
+   st_texture_release_all_sampler_views(st, obj);
+   for (unsigned f = 0; f < faces; f++) {
+      for (unsigned l = 0; l < MAX_TEXTURE_LEVELS; l++) {
+         struct gl_texture_image *img = obj->Image[f][l];
+         if (!img)
+            continue;
+         for (unsigned i = 0; i < count; i++)
+            if (img->pt == old[i]) {
+               pipe_resource_reference(&img->pt, fresh[i]);
+               break;
+            }
+         img->R4OSImageSibling = false;
+         free(img->R4OSImageLayers);
+         img->R4OSImageLayers = NULL;
+         _mesa_update_fbo_texture(ctx, obj, f, l);
+      }
+   }
+   for (unsigned i = 0; i < count; i++)
+      pipe_resource_reference(&fresh[i], NULL);
+   _mesa_dirty_texobj(ctx, obj);
+   obj->needs_validation = true;
+   ST_SET_FRAMEBUFFER_STATES(ctx->NewDriverState);
+   return GL_TRUE;
+}
