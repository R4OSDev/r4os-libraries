+static EGLint
+_eglR4OSValidateIntAttribs(const EGLAttrib *attrs, bool image)
+{
+   for (const EGLAttrib *a = attrs; a && a[0] != EGL_NONE; a += 2) {
+      if (a[0] < INT32_MIN || a[0] > INT32_MAX)
+         return image ? EGL_BAD_PARAMETER : EGL_BAD_ATTRIBUTE;
+      if (a[1] < INT32_MIN || a[1] > INT32_MAX) {
+         if (image && a[0] == EGL_GL_TEXTURE_LEVEL)
+            return EGL_BAD_MATCH;
+         return image ? EGL_BAD_PARAMETER : EGL_BAD_ATTRIBUTE;
+      }
+   }
+   return EGL_SUCCESS;
+}
+#endif
